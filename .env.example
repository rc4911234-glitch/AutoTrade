# ==============================================================================
# Trad-Auto Environment Configuration
# ==============================================================================

# Core Operating Mode: BACKTEST, PAPER, LIVE (Default: BACKTEST)
TRADING_MODE=PAPER

# Live Trading Safeguards (Must be explicitly set for LIVE mode)
ENABLE_LIVE_TRADING=false
CONFIRM_REAL_MONEY_TRADING=false

# Owner Authentication & Local CLI
OWNER_CLI_ENABLED=true
OWNER_WHATSAPP_NUMBER=+1234567890
WHATSAPP_APP_SECRET=

# Twilio WhatsApp Outbound & Inbound Webhooks
TWILIO_ACCOUNT_SID=AC_YOUR_TWILIO_ACCOUNT_SID_HERE
TWILIO_AUTH_TOKEN=YOUR_TWILIO_AUTH_TOKEN_HERE
TWILIO_WHATSAPP_NUMBER=whatsapp:+14155238886

# Session Defaults
CONFIRMATION_TIMEOUT_SECONDS=120
DEFAULT_SESSION_DURATION_HOURS=8
MAX_AUTHORIZED_CAPITAL_PER_SESSION=1000.00

# Audit & Privacy
STORE_RAW_CHAT_TEXT=false

# Persistence & File Storage
SQLITE_DB_PATH=data/trad_auto.db
SQLITE_BUSY_TIMEOUT_MS=5000
DATA_DIR=data
LOG_DIR=logs

# Binance USD-M Futures Exchange Configuration
BINANCE_API_KEY=
BINANCE_API_SECRET=
BINANCE_TESTNET=true
BINANCE_FUTURES_BASE_URL=https://testnet.binancefuture.com
BINANCE_WS_BASE_URL=wss://stream.binancefuture.com

# News & Macro Volatility Shield Configuration
ENABLE_NEWS_SHIELD=true
NEWS_BLACKOUT_PRE_MINUTES=15
NEWS_BLACKOUT_POST_MINUTES=15
NEWS_POLL_INTERVAL_SECONDS=60
CRYPTOPANIC_API_TOKEN=
